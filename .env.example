# YouTube Data API v3のAPIキー
# https://console.cloud.google.com/apis/credentials でAPIキーを取得してください
YOUTUBE_API_KEY=your_api_key_here

# whisper.cpp によるセリフ音声認識用（任意）
# CLI バイナリ名（未設定なら 'whisper-cli'）。PATH 上にある必要あり
WHISPER_CLI=whisper-cli
# GGML モデルファイルの絶対パス（音声認識機能を使う場合は必須）
WHISPER_MODEL_PATH=/absolute/path/to/ggml-large-v3.bin
# 認識言語（未設定なら 'ja'）
WHISPER_LANGUAGE=ja
